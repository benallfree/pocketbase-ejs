    }
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/benallfree/pocketbase-ejs.git"
  },
  "bugs": "https://github.com/benallfree/pocketbase-ejs/issues",
  "homepage": "https://github.com/benallfree/pocketbase-ejs",
  "dependencies": {
    "pocketbase-node": "^0.0.3"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.24.5",
    "@changesets/cli": "^2.27.11",
    "eslint": "^9.1.1",
    "jake": "^12.10.1",
    "lru-cache": "^4.0.1",
    "mocha": "^10.2.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=0.12.18"
  },
  "scripts": {
    "build": "npx jake compile",
    "test": "npx jake test",
    "prepublishOnly": "npx jake compile"
  },
  "files": [
    "lib"
