{
  "name": "pocketbase-ejs",
  "description": "Embedded JavaScript templates",
  "keywords": [
    "template",
    "templating",
    "engine",
    "ejs",
    "pocketbase"
  ],
  "version": "7.0.2001",
  "author": "Matthew Eernisse <matthew.eernisse@gmail.com>",
  "license": "Apache-2.0",
  "main": "./lib/cjs/ejs.js",
  "module": "./lib/esm/ejs.js",
